    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Откуда читать обновления Telegram: offset живёт в staticData сценария и переживает рестарты.\n// Telegram Trigger (вебхук от Telegram) не подходит — входящих соединений к серверу нет,\n// поэтому опрос getUpdates раз в минуту.\nconst P = $('Параметры').first().json;\nif (!P.chat_id || String(P.chat_id).includes('REPLACE')) throw new Error('Параметры → chat_id не задан (TELEGRAM_CHAT_ID)');\nif (P.bot_token_set !== 'да') throw new Error('TELEGRAM_BOT_TOKEN не задан в окружении n8n — нужен для getUpdates');\nconst store = $getWorkflowStaticData('global');\nreturn [{ json: { offset: Number(store.offset) || 0 } }];\n"
      },
      "name": "Смещение из памяти",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        400
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/getUpdates",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "offset",
              "value": "={{ $json.offset }}"
            },
            {
              "name": "timeout",
              "value": "20"
            },
            {
              "name": "allowed_updates",
              "value": "[\"message\"]"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "name": "Telegram: getUpdates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        400
      ],
      "notes": "Длинный опрос: интервал сценария 30 с > ожидание 20 с + обработка, иначе два параллельных getUpdates дадут 409. Ошибка ноды роняет прогон без сообщения владельцу — offset не сдвинут, следующий прогон повторит."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Разбор обновлений Telegram. Обрабатываем только чат владельца (TELEGRAM_CHAT_ID), чужое — молча мимо.\n// Offset продвигаем СРАЗУ: даже если команда дальше упадёт, следующий опрос её не повторит (иначе — цикл).\nconst P = $('Параметры').first().json;\nconst r = $input.first().json;\nif (!r || r.ok !== true) throw new Error('getUpdates: ' + JSON.stringify(r).slice(0, 300));\nconst updates = Array.isArray(r.result) ? r.result : [];\nconst store = $getWorkflowStaticData('global');\nif (updates.length) store.offset = Math.max(...updates.map((u) => Number(u.update_id))) + 1;\n\nconst HELP = [\n  'Команды:',\n  '/task <текст> [@ <срок>] — задача в Todoist («Обязательства»); срок по-русски: @ завтра 12:00, без срока — сегодня 20:00',\n  '/lead <текст> — лид в EspoCRM (источник telegram)',\n  'любой другой текст — элемент ленты портала (source manual)',\n].join('\\n');\nconst cut = (s, n) => String(s ?? '').slice(0, n);\nconst nowEspo = DateTime.utc().toFormat('yyyy-LL-dd HH:mm:ss');\n\n// Ссылка на сообщение: для супергрупп/каналов — t.me/c/…, для пересланного поста канала — его адрес,\n// для личного чата с ботом ссылки нет → https://t.me/ (контракт требует url).\nfunction messageUrl(m) {\n  const c = m.chat || {};\n  if (c.username) return `https://t.me/${c.username}/${m.message_id}`;\n  const id = String(c.id);\n  if (id.startsWith('-100')) return `https://t.me/c/${id.slice(4)}/${m.message_id}`;\n  const fo = m.forward_origin;\n  if (fo && fo.type === 'channel' && fo.chat && fo.chat.username && fo.message_id) {\n    return `https://t.me/${fo.chat.username}/${fo.message_id}`;\n  }\n  return 'https://t.me/';\n}\n\nconst out = [];\nconst push = (base, extra) => out.push({ json: Object.assign({}, base, extra) });\nfor (const u of updates) {\n  const m = u.message;\n  if (!m || !m.chat || String(m.chat.id) !== String(P.chat_id)) continue;\n  const text = String(m.text ?? m.caption ?? '').trim();\n  if (!text) continue;\n  const base = {\n    chat_id: String(P.chat_id), update_id: u.update_id,\n    project_id: store.todoist_project_id ? String(store.todoist_project_id) : '',\n  };\n  const cmd = /^\\/([a-zA-Z_]+)(?:@\\w+)?(?:\\s+([\\s\\S]*))?$/.exec(text);\n  const name = cmd ? cmd[1].toLowerCase() : null;\n  const arg = cmd ? (cmd[2] || '').trim() : '';\n\n  if (name === 'start' || name === 'help') {\n    push(base, { kind: 'reply', what: 'справка', ok_text: HELP });\n  } else if (name === 'task') {\n    if (!arg) { push(base, { kind: 'reply', what: 'задача', ok_text: '✗ /task: нужен текст. Пример: /task Позвонить Иванову @ завтра 12:00' }); continue; }\n    const at = /^([\\s\\S]*?)\\s+@\\s*(.+)$/.exec(arg); // срок — после последнего « @ »\n    const content = (at ? at[1] : arg).trim();\n    const due = at ? at[2].trim() : 'сегодня 20:00';\n    push(base, { kind: 'task', what: 'задача', ok_text: `✓ задача: ${content} (срок: ${due})`,\n      body: { content, due_string: due, due_lang: 'ru' } });\n  } else if (name === 'lead') {\n    if (!arg) { push(base, { kind: 'reply', what: 'лид', ok_text: '✗ /lead: нужен текст. Пример: /lead Иван, бот для записи, 30 000 ₽' }); continue; }\n    push(base, { kind: 'lead', what: 'лид', ok_text: `✓ лид: ${cut(arg, 100)}`,\n      body: { lastName: cut(arg, 100), description: arg, status: 'responded', source: 'telegram', cRespondedAt: nowEspo } });\n  } else if (name) {\n    push(base, { kind: 'reply', what: 'команда', ok_text: `✗ неизвестная команда /${name}\\n\\n${HELP}` });\n  } else {\n    const title = cut(text.split('\\n')[0].trim(), 80) || cut(text, 80);\n    push(base, { kind: 'feed', what: 'лента', ok_text: `✓ в ленте: ${title}`,\n      body: {\n        schema_version: 1, source: 'manual', external_id: `tg-${u.update_id}`, title,\n        url: messageUrl(m),\n        published_at: DateTime.fromSeconds(Number(m.date) || Date.now() / 1000).toUTC().toISO(),\n        text: cut(text, 20000),\n      } });\n  }\n}\nreturn out; // 0 элементов → дальше ничего не выполняется\n"
      },
      "name": "Разбор сообщений",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

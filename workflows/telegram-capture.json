      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Ищем проект «Обязательства» по имени и кэшируем id в staticData — следующие команды список не запрашивают.\nconst j = $input.item.json;\nconst list = Array.isArray(j) ? j : (Array.isArray(j.results) ? j.results : []);\nconst p = list.find((x) => String(x.name || '').trim().toLowerCase() === 'обязательства');\nif (!p) throw new Error('в Todoist нет проекта «Обязательства» (есть: ' + list.map((x) => x.name).join(', ') + ')');\nconst store = $getWorkflowStaticData('global');\nstore.todoist_project_id = String(p.id);\nreturn { json: { project_id: String(p.id) } };\n"
      },
      "name": "Проект «Обязательства»",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,

    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Итог для владельца: успех → готовый текст из разбора, ошибка → её причина.\n// Offset уже продвинут в «Разбор сообщений», поэтому сбой одной команды опрос не зациклит.\n// Текст ошибки: n8n кладёт её в json.error строкой или объектом {message, description}.\nfunction errText(e) {\n  if (e === null || e === undefined) return 'неизвестная ошибка';\n  if (typeof e === 'string') return e;\n  const parts = [e.message, e.description].filter(Boolean);\n  return parts.length ? parts.join(' — ') : JSON.stringify(e);\n}\nconst src = $('Разбор сообщений').item.json;\nconst e = $json.error;\nlet text;\nif (e !== undefined) {\n  text = `✗ ${src.what}: ${errText(e)}`;\n  // Задача не создалась — возможно, проект пересоздан: сбрасываем кэш, следующая команда найдёт его заново.\n  if (src.kind === 'task') { try { delete $getWorkflowStaticData('global').todoist_project_id; } catch (_) { /* не критично */ } }\n} else if (src.kind === 'feed' && Number($json.statusCode) === 200) {\n  text = src.ok_text + ' (уже было)'; // 200 — дубль по (source, external_id), 201 — новый\n} else {\n  text = src.ok_text;\n}\nreturn { json: { chat_id: src.chat_id, text } };\n"
      },
